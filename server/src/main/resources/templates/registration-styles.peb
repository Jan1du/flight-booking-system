{# Used gemini for the toggle password styling (lines 3-31) #}
<style>
    .password-wrapper {
        position: relative;
        display: block;
    }

    .toggle-password-btn {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        color: var(--pico-muted-color);
        display: flex;
        align-items: center;
    }

    .toggle-password-btn:hover {
        background: transparent;
        color: var(--pico-color);
    }

    .password-wrapper input {
        padding-right: 2.5rem;
        margin-bottom: 0;
    }

    {# Error messages #}
    .password-wrapper input[aria-invalid="true"] {
        padding-right: 4.5rem;
    }

    .password-wrapper input[aria-invalid="true"] + .toggle-password-btn {
        right: 2.5rem;
    }

    .error-msg {
        color: var(--pico-del-color);
    }
</style>
{# Base template #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Book your flight{% endblock %}</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">

    {# Tweaking the css #}
    <style>
        header {
            border-bottom: 2px solid var(--pico-muted-border-color);
            margin-bottom: 2rem;
            padding-bottom: 1rem;
        }
        .active-link {
            text-decoration: underline;
            text-underline-offset: 4px;
        }
    </style>

    {% block styles %}
    {% endblock %}
</head>

<body>
    <header class="container">
        <nav>
            <ul>
                <li><a href="/" class="{{ active_nav == 'book' ? 'contrast active-link' : 'secondary' }}"><strong>Book</strong></a></li>
                <li><a href="/manage" class="{{ active_nav == 'manage' ? 'contrast active-link' : 'secondary' }}">Manage</a></li>
                <li><a href="/about" class="{{ active_nav == 'about' ? 'contrast active-link' : 'secondary' }}">About us</a></li>
            </ul>

            <ul>
                <li><a href="/login" class="{{ active_nav == 'login' ? 'contrast active-link' : 'secondary' }}">Login</a></li>
                <li><a href="/register" class="{{ active_nav == 'register' ? 'contrast active-link' : 'secondary' }}">Register</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block content %}
        {% endblock %}
    </main>


    {% block scripts %}
    {% endblock %}
</body>
</html>
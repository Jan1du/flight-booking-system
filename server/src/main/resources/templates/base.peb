{# Base template #}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Book your flight{% endblock %}</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">

    {# Tweaking the css #}
    <style>
        :root {
            --pico-font-family: "Segoe UI", Arial, sans-serif;
            --pico-primary: #0077b6;
            --pico-primary-hover: #005f8f;
            --pico-background-color: #eef5fb;
            --pico-color: #1d3557;
        }

        html,
        body {
            margin: 0;
            min-height: 100vh;

            background: linear-gradient(
                rgba(255, 255, 255, 0.85),
                rgba(255, 255, 255, 0.85)
            ),
            url("https://images.unsplash.com/photo-1436491865332-7a61a109cc05");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        body {
            min-height: 100vh;
        }

        header.container {
            max-width: 1150px;
            margin: 0 auto 2rem auto;
            padding: 1.2rem 2rem;
            background: white;
            border-radius: 0 0 18px 18px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
            border-bottom: none;
        }

        header nav a {
            color: #1d3557;
            font-weight: 500;
            text-decoration: none;
        }

        header nav a:hover {
            color: #0077b6;
        }

        .active-link {
            color: #0077b6;
            font-weight: 700;
            text-decoration: none;
        }

        main.container {
            max-width: 1150px;
            margin: 0 auto;
            padding: 0 1.5rem 4rem 1.5rem;
            background: transparent;
            box-shadow: none;
            border-radius: 0;
        }

        form {
            background: white;
            padding: 2rem;
            border-radius: 20px;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.1);
        }

        label {
            color: #4a6078;
            font-weight: 600;
        }

        input,
        select {
            border-radius: 10px !important;
            border: 1px solid #c9d8e6 !important;
            background-color: white !important;
            color: #1d3557 !important;
        }

        input::placeholder {
            color: #8798aa;
        }

        button,
        input[type="submit"] {
            background-color: #0077b6 !important;
            border: none !important;
            border-radius: 12px !important;
            font-weight: 700;
            padding: 0.9rem 1rem;
            box-shadow: 0 4px 12px rgba(0, 119, 182, 0.25);
        }

        button:hover,
        input[type="submit"]:hover {
            background-color: #005f8f !important;
        }

        input[type="radio"] {
            appearance: auto !important;
            width: 18px;
            height: 18px;
            color: #12355b;
        }

        h1,
        h2,
        h3 {
            color: #12355b;
            font-weight: 700;
        }

        @media (max-width: 768px) {
            header.container {
                margin-bottom: 1rem;
                border-radius: 0;
            }

            form {
                padding: 1.2rem;
            }
        }
    </style>

    {% block styles %}
    {% endblock %}
</head>

<body>
    <header class="container">
        {% include "navbar.peb" %}
    </header>

    <main class="container">
        {% block content %}
        {% endblock %}
    </main>

    {% block scripts %}
    {% endblock %}
</body>
</html>
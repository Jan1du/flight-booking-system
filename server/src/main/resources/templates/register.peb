{# @pebvariable name="error" type="String" #}
{% extends "base.peb" %}
{% block title %}Register{% endblock %}

{# Used gemini for the toggle password styling (lines 6-38,57-60,71-74) #}
{% block styles %}
{% include "registration-styles.peb" %}

<style>
    .register-container {
        max-width: 460px;
        margin: 0 auto;
        padding-top: 3rem;
    }

    .register-card {
        background-color: rgba(255, 255, 255, 0.96);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .register-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 1rem auto;
        border-radius: 50%;
        background-color: #fdeaea;
        color: #d62828;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .register-title {
        text-align: center;
        margin-bottom: 0.5rem;
        color: #7f1d1d;
    }

    .register-line {
        width: 50px;
        height: 3px;
        background-color: #d62828;
        border-radius: 999px;
        margin: 0 auto 1.8rem auto;
    }

    .register-form {
        text-align: left;
    }

    .register-form label {
        font-weight: 600;
        color: #1f2937;
    }

    .register-form input {
        border-radius: 12px;
    }

    .register-confirm-btn {
        width: 100%;
        margin-top: 1.5rem;
        padding: 0.9rem 1rem;
        border-radius: 999px;
        background-color: #d62828 !important;
        border-color: #d62828 !important;
        color: white !important;
        font-weight: 600;
    }

    .register-confirm-btn:hover {
        background-color: #b71c1c !important;
        border-color: #b71c1c !important;
    }

    .login-link {
        text-align: center;
        margin-top: 1rem;
    }

    .login-link a {
        color: #d62828;
        font-weight: 500;
    }

    .toggle-password-btn {
        background: white !important;
        color: black !important;
        border: 1px solid #d1d5db !important;
        box-shadow: none !important;
    }

    .toggle-password-btn:hover {
        background: #f3f4f6 !important;
        color: black !important;
    }
</style>
{% endblock %}

{# Used gemini for specific style adjustments (lines 43,45,80,82) #}
{# Used gemini for generating a svg for toggle password button (lines 38-41,61-64 #}
{% block content %}
<div class="register-container">

    <article class="register-card">
        <div class="register-icon">✈</div>

        <h2 class="register-title">Create your account</h2>
        <div class="register-line"></div>

        <form action="/register" method="POST" class="register-form">
            <label>
                Email:
                <input type="email" name="email" required
                    {% if error and error == "email-error" %}aria-invalid="true"{% endif %}>

                {% if error and error == "email-error" %}
                <small class="error-msg" role="alert">
                    Email is already registered
                </small>
                {% endif %}
            </label>

            <label>
                Password:
                <div class="password-wrapper">
                    <input type="password" name="password" id="password-input" required
                        {% if error and (error == "password-error" or error == "password-mismatch") %}aria-invalid="true"{% endif %}>

                    <button type="button" class="toggle-password-btn" id="toggle-password" aria-label="Show password">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                {% if error and error == "password-error" %}
                <small class="error-msg" role="alert">
                    Password is too weak:<br>
                    - Must be at least 8 characters long<br>
                    - Must contain at least one uppercase and lowercase letter<br>
                    - Must contain at least one number
                </small>
                {% endif %}
            </label>

            <label>
                Confirm password:
                <div class="password-wrapper">
                    <input type="password" name="confirm_password" id="confirm-password-input" required
                        {% if error and error == "password-mismatch" %}aria-invalid="true"{% endif %}>

                    <button type="button" class="toggle-password-btn" id="toggle-confirm-password" aria-label="Show password">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                {% if error and error == "password-mismatch" %}
                <small class="error-msg" role="alert">
                    Passwords do not match
                </small>
                {% endif %}
            </label>

            <button type="submit" class="register-confirm-btn">Confirm</button>

            <div class="login-link">
                <a href="/login" class="secondary"><small>Already have an account?</small></a>
            </div>
        </form>
    </article>
</div>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const togglePassword = document.getElementById("toggle-password");
        const passwordInput = document.getElementById("password-input");
        const toggleConfirmPassword = document.getElementById("toggle-confirm-password");
        const confirmPasswordInput = document.getElementById("confirm-password-input");

        togglePassword.addEventListener("click", function() {
            {# Check current type and toggle it #}
            const currentType = passwordInput.getAttribute("type");
            const newType = currentType === "password" ? "text" : "password";

            passwordInput.setAttribute("type", newType);

            {# Changing the icon colour #}
            this.style.color = "black";
        });

        toggleConfirmPassword.addEventListener("click", function() {
            const currentType = confirmPasswordInput.getAttribute("type");
            const newType = currentType === "password" ? "text" : "password";

            confirmPasswordInput.setAttribute("type", newType);

            this.style.color = "black";
        });
    });
</script>
{% endblock %}
{# @pebvariable name="trip_type" type="String" #}
{# @pebvariable name="origin" type="String" #}
{# @pebvariable name="destination" type="String" #}
{# @pebvariable name="depart_date" type="String" #}
{# @pebvariable name="return_date" type="String" #}
{# @pebvariable name="cabin_class" type="String" #}
{# @pebvariable name="count" type="Int" #}
{# @pebvariable name="flights" type="List<Flight>" #}
{# @pebvariable name="price_multi" type="Double" #}
{% extends "base.peb" %}

{% block content %}

<div id="flight-container">
    <h1>Flight Results</h1>

    {% if origin or destination %}
        <p>
            Showing results
            {% if origin %}from <strong>{{ origin }}</strong>{% endif %}
            {% if destination %} to <strong>{{ destination }}</strong>{% endif %}
            {% if depart_date %} on <strong>{{ depart_date }}</strong>{% endif %}
        </p>
    {% endif %}

    {% if count > 0 %}
        {% for flight in flights %}
            <article style="border: 1px solid #ddd; border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: start; gap: 1rem;">
                    <div>
                        <h3 style="margin-bottom: 0.5rem;">
                            {{ flight.airline.name }}
                        </h3>
                        <p style="margin-bottom: 0.35rem;"><strong>Route:</strong>
                            {{ flight.departureAirport.name }} to {{ flight.arrivalAirport.name }}
                        </p>
                        <p style="margin-bottom: 0.35rem;"><strong>Depart:</strong>
                            {{ flight.date }} at {{ flight.departureTime }}
                        </p>
                        <p style="margin-bottom: 0.35rem;"><strong>Arrival:</strong> {{ flight.arrivalTime }}</p>
                        <p style="margin-bottom: 0.35rem;"><strong>Cabin:</strong> {{ cabin_class }} </p>
                    </div>

                    <div style="min-width: 180px; text-align: right;">
                        <p style="margin-bottom: 0.35rem; font-size: 0.9rem; color: #666;">
                            Total price
                        </p>
                        <p style="margin-bottom: 0.5rem; font-size: 1.8rem; font-weight: 700; color: #0a5bd8;">
                            GBP {{ (flight.defaultPrice * price_multi) | numberformat("0.00") }}
                        </p>
                        <p style="margin: 0; font-size: 0.95rem;">
                            <strong>Discounts:</strong> None currently available
                        </p>

                        {% if trip_type == 'return' %}
                            <button hx-get="/search-return?origin={{ destination }}&destination={{ origin }}&depart_date={{ return_date }}&cabin_class={{ cabin_class }}"
                                    hx-target="#flight-container"
                                    hx-swap="outerHTML">
                                Select
                            </button>
                        {% else %}
                            <a href="/passenger-info">
                                <button type="button">Select</button>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </article>
        {% endfor %}
    {% else %}
        <p>No matching flights found.</p>
    {% endif %}
</div>
{% endblock %}

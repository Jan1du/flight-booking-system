{# @pebvariable name="numAdults" type="Int" #}
{# @pebvariable name="numChildren" type="Int" #}
{# @pebvariable name="validChildDate" type="String" #}
{# @pebvariable name="today" type="String" #}
{% extends "base.peb" %}

{% block title %}Passenger Details{% endblock %}

{# Used gemini for css styling #}
{% block content %}
<div class="booking-container" style="max-width: 800px; margin: 0 auto; padding: 20px;">

    <div class="progress-indicator" style="display: flex; gap: 20px; margin-bottom: 30px; font-weight: bold;">
        <span style="color: black;">&#9679; Personal details</span>
        <span style="color: gray;">&#9679; Seat selection</span>
        <span style="color: gray;">&#9679; Payment</span>
    </div>

    <form action="/submit-passenger-info" method="POST">

    {% if numAdults > 0 %}
        <h2 style="margin-bottom: 10px;">Adults (18+)</h2>

        {% for i in 1..numAdults %}
        <div class="passenger-card" style="background: #e9ecef; padding: 20px; margin-bottom: 20px; border: 1px solid #ccc;">
            <h3>Adult {{ i }}</h3>

            <div style="margin-top: 15px;">
                <label for="adultFirstName_{{ i }}" style="display: block; margin-bottom: 5px;">First Name</label>
                <input type="text" id="adultFirstName_{{ i }}" name="adultFirstName_{{ i }}" required style="width: 100%; padding: 8px;">
            </div>

            <div style="margin-top: 15px;">
                <label for="adultLastName_{{ i }}" style="display: block; margin-bottom: 5px;">Last Name</label>
                <input type="text" id="adultLastName_{{ i }}" name="adultLastName_{{ i }}" required style="width: 100%; padding: 8px;">
            </div>

            <div style="margin-top: 15px;">
                <label for="adultDob_{{ i }}" style="display: block; margin-bottom: 5px;">Date of Birth</label>
                <input type="date" id="adultDob_{{ i }}" name="adultDob_{{ i }}" max={{ validChildDate }} required style="width: 100%; padding: 8px;">
            </div>
        </div>
        {% endfor %}
    {% endif %}

    {% if numChildren > 0 %}
        <h2 style="margin-bottom: 10px; margin-top: 30px;">Children (0-17)</h2>
        {% for i in 1..numChildren %}
            <div class="passenger-card" style="background: #e9ecef; padding: 20px; margin-bottom: 20px; border: 1px solid #ccc;">
                <h3>Child {{ i }}</h3>

                <div style="margin-top: 15px;">
                    <label for="childFirstName_{{ i }}" style="display: block; margin-bottom: 5px;">First Name</label>
                    <input type="text" id="childFirstName_{{ i }}" name="childFirstName_{{ i }}" required style="width: 100%; padding: 8px;">
                </div>

                <div style="margin-top: 15px;">
                    <label for="childLastName_{{ i }}" style="display: block; margin-bottom: 5px;">Last Name</label>
                    <input type="text" id="childLastName_{{ i }}" name="childLastName_{{ i }}" required style="width: 100%; padding: 8px;">
                </div>

                <div style="margin-top: 15px;">
                    <label for="childDob_{{ i }}" style="display: block; margin-bottom: 5px;">Date of Birth</label>
                    <input type="date" id="childDob_{{ i }}" name="childDob_{{ i }}" min={{ validChildDate }} max={{ today }} required style="width: 100%; padding: 8px;">
                </div>
            </div>
        {% endfor %}
    {% endif %}

        <div class="form-actions" style="display: flex; justify-content: flex-end; margin-top: 20px;">
            <button type="submit" style="background: #6c757d; color: white; padding: 10px 20px; border: none; cursor: pointer;">
                Next
            </button>
        </div>

    </form>
</div>
{% endblock %}
{% extends "base.peb" %}
{% block title %}Complete Profile{% endblock %}

{% block styles %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/css/intlTelInput.css">

{# Fix for Pico CSS: Forces the flag dropdown wrapper to span the full width of the box #}
<style>
    .iti {
        width: 100%;
    }
</style>
{% endblock %}

{% block content %}
<div style="max-width: 500px; margin: 0 auto; padding-top: 2rem;">
    <h2 style="text-align: center; margin-bottom: 2rem;">Complete your profile</h2>

    <article>
        <form action="/user-info" method="POST" id="profile-form">

            <label>
                First name:
                <input type="text" name="first_name" required>
            </label>

            <label>
                Last name:
                <input type="text" name="last_name" required>
            </label>

            <label>
                Phone number:
                <input type="tel" id="visible-phone" required>

                <input type="hidden" name="phone_no" id="hidden-phone">
            </label>

            <div style="display: flex; justify-content: flex-end; margin-top: 2rem;">
                <button type="submit" style="width: auto; margin: 0; padding: 0.5rem 2rem;">Confirm</button>
            </div>

        </form>
    </article>
</div>
{% endblock %}


{# Used gemini to help with displaying and formating the phone number before submission (lines 51-78) #}
{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/intlTelInput.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const visibleInput = document.querySelector("#visible-phone");
        const hiddenInput = document.querySelector("#hidden-phone");
        const form = document.querySelector("#profile-form");

        const iti = window.intlTelInput(visibleInput, {
            {# Change this to your primary target country #}
            initialCountry: "gb",
            strictMode: true,
            {# The utils script enables the formatting and validation tools #}
            utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/utils.js"
        });

        form.addEventListener("submit", function(event) {
            {# Prevents the form from submitting immediately #}
            event.preventDefault();

            {# Checking phone no validity #}
            if (!iti.isValidNumber()) {
                alert("Please enter a valid phone number");
                visibleInput.focus();
                return;
            }

            {# Get the E.164 formatted number (+44...) and put it in the hidden input #}
            hiddenInput.value = iti.getNumber();
            form.submit();
        });
    });
</script>
{% endblock %}
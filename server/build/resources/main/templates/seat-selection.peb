{# @pebvariable name="totalPassengerCount" type="Int" #}
{# @pebvariable name="isReturn" type="Boolean" #}

{% extends "base.peb" %}
{% block title %}Seat Selection{% endblock %}

{% block styles %}
<style>
    .plane-cabin {
        max-width: 300px;
        margin: 2rem auto;
        padding: 2rem;
        background: white;
        border-radius: 40px; /* Shaped like a plane fuselage */
        border: 2px solid #c9d8e6;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.05);
    }

    .seat-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        justify-items: center;
    }

    .seat {
        width: 50px;
        height: 50px;
        border-radius: 8px;
        background-color: #eef5fb;
        border: 2px solid #0077b6;
        color: #0077b6;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .seat:hover {
        background-color: #c9d8e6;
    }

    .seat.selected {
        background-color: #0077b6;
        color: white;
        transform: scale(1.05);
        box-shadow: 0 4px 10px rgba(0, 119, 182, 0.4);
    }

    .status-text {
        text-align: center;
        margin-bottom: 1.5rem;
        color: #4a6078;
        font-weight: 600;
    }
</style>
{% endblock %}

{% block content %}
<div class="booking-container" style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <form action="/submit-seats" method="POST" id="seatForm">

        <input type="hidden" name="outboundSeats" id="outboundInput">
        {% if isReturn %}
            <input type="hidden" name="returnSeats" id="returnInput">
        {% endif %}

        <h2 style="text-align: center;">Outbound Flight</h2>
        <div class="plane-cabin outbound-cabin">
            <div class="seat-grid">
            {% for row in 1..10 %}
                {% for col in ["A", "B", "C"] %}
                <div class="seat" data-flight="outbound" data-seat="{{ row }}{{ col }}">
                    {{ row }}{{ col }}
                </div>
                {% endfor %}
            {% endfor %}
            </div>
        </div>

        {% if isReturn %}
        <h2 style="text-align: center; margin-top: 40px;">Return Flight</h2>
        <div class="plane-cabin return-cabin">
            <div class="seat-grid">
            {% for row in 1..10 %}
                {% for col in ["A", "B", "C"] %}
                <div class="seat" data-flight="return" data-seat="{{ row }}{{ col }}">
                    {{ row }}{{ col }}
                </div>
                {% endfor %}
            {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="form-actions" style="margin-top: 30px; text-align: right;">
            <button type="submit" id="nextButton" disabled>Next</button>
        </div>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script>
{# Seat selection logic #}
document.addEventListener("DOMContentLoaded", function() {
    const maxSeats = {{ totalPassengerCount }};
    const isReturn = {{ isReturn ? 'true' : 'false' }};

    let outboundSelected = [];
    let returnSelected = [];

    const nextButton = document.getElementById('nextButton');
    const outboundInput = document.getElementById('outboundInput');
    const returnInput = document.getElementById('returnInput');

    document.querySelectorAll('.seat').forEach(seat => {
        seat.addEventListener('click', function() {
            const seatId = this.getAttribute('data-seat');
            const flightType = this.getAttribute('data-flight');

            let targetArray = flightType === 'outbound' ? outboundSelected : returnSelected;

            if (this.classList.contains('selected')) {
                this.classList.remove('selected');
                targetArray.splice(targetArray.indexOf(seatId), 1);
            } else {
                if (targetArray.length < maxSeats) {
                    this.classList.add('selected');
                    targetArray.push(seatId);
                } else {
                    alert(`You already selected all seats for the ${flightType} flight!`);
                }
            }

            checkFormValidity();
        });
    });

    {# Formatting the , seperated arrays that will be sent to the backend #}
    function checkFormValidity() {
        outboundInput.value = outboundSelected.join(',');
        if (isReturn) {
            returnInput.value = returnSelected.join(',');
        }

        const outboundValid = outboundSelected.length === maxSeats;
        const returnValid = isReturn ? (returnSelected.length === maxSeats) : true;

        nextButton.disabled = !(outboundValid && returnValid);
    }
});
</script>
{% endblock %}
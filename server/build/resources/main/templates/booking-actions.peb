{% extends "base.peb" %}
{# @pebvariable name="booking" type="com.flight.db.Booking" #}

{% block title %}Manage Booking #{{ booking.id }}{% endblock %}

{% block content %}
<a href="/manage" class="secondary" style="display: inline-block; margin-bottom: 1.5rem;">&larr; Back to my bookings</a>

<h1>Booking #{{ booking.id }}</h1>

<article style="border: 1px solid var(--pico-muted-border-color); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem;">
    <h3 style="margin-bottom: 1rem;">{{ booking.flight.airline.name }}</h3>
    <div class="grid">
        <p style="margin-bottom: 0.35rem;"><strong>From:</strong> {{ booking.flight.departureAirport.name }}</p>
        <p style="margin-bottom: 0.35rem;"><strong>To:</strong> {{ booking.flight.arrivalAirport.name }}</p>
    </div>
    <div class="grid">
        <p style="margin-bottom: 0.35rem;"><strong>Date:</strong> {{ booking.flight.date }}</p>
        <p style="margin-bottom: 0.35rem;">
            <strong>Time:</strong> {{ booking.flight.departureTime }} &ndash; {{ booking.flight.arrivalTime }}
        </p>
    </div>
    <div class="grid">
        <p style="margin-bottom: 0;"><strong>Cabin class:</strong> {{ booking.cabinClass }}</p>
        <p style="margin-bottom: 0;"><strong>Passengers:</strong> {{ booking.paxCount }}</p>
    </div>
</article>

<h2>What would you like to do?</h2>

<div class="grid">
    <a href="/manage/{{ booking.id }}/change-flight" role="button" class="outline">
        Change flight
    </a>
    <a href="/manage/{{ booking.id }}/choose-seat" role="button" class="outline">
        Choose seat
    </a>
</div>

<div class="grid" style="margin-top: 0.75rem;">
    <a href="/manage/{{ booking.id }}/upgrade-cabin" role="button" class="outline">
        Upgrade cabin class
    </a>
    <a href="/manage/{{ booking.id }}/cancel" role="button" class="outline contrast">
        Cancel flight
    </a>
</div>
{% endblock %}

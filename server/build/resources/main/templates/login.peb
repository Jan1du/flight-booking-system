{# @pebvariable name="error" type="Boolean" #}
{% extends "base.peb" %}
{% block title %}Login{% endblock %}

{# Used gemini for the toggle password styling (lines 6-38,60-63) #}
{% block styles %}
{% include "registration-styles.peb" %}

<style>
    .login-container {
        max-width: 460px;
        margin: 0 auto;
        padding-top: 3rem;
    }

    .login-card {
        background-color: rgba(255, 255, 255, 0.96);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .login-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 1rem auto;
        border-radius: 50%;
        background-color: #fdeaea;
        color: #d62828;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .login-title {
        text-align: center;
        margin-bottom: 0.5rem;
        color: #7f1d1d;
    }

    .login-line {
        width: 50px;
        height: 3px;
        background-color: #d62828;
        border-radius: 999px;
        margin: 0 auto 1.8rem auto;
    }

    .login-form {
        text-align: left;
    }

    .login-form label {
        font-weight: 600;
        color: #1f2937;
    }

    .login-form input {
        border-radius: 12px;
    }

    .login-confirm-btn {
        width: 100%;
        margin-top: 1.5rem;
        padding: 0.9rem 1rem;
        border-radius: 999px;
        background-color: #d62828 !important;
        border-color: #d62828 !important;
        color: white !important;
        font-weight: 600;
    }

    .login-confirm-btn:hover {
        background-color: #b71c1c !important;
        border-color: #b71c1c !important;
    }

    .register-link {
        text-align: center;
        margin-top: 1rem;
    }

    .register-link a {
        color: #d62828;
        font-weight: 500;
    }

    .password-wrapper {
        position: relative;
    }

    .password-wrapper input {
        padding-right: 3rem;
    }

    .toggle-password-btn {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        border: 1px solid #d1d5db !important;
        background: white !important;
        color: black !important;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 !important;
        cursor: pointer;
        box-shadow: none !important;
    }

    .toggle-password-btn:hover {
        background: #f3f4f6 !important;
        color: black !important;
        border-color: #9ca3af !important;
    }
</style>
{% endblock %}

{# Used gemini for specific style adjustments (lines 43,45,69,71) #}
{% block content %}
<div class="login-container">

    <article class="login-card">
        <div class="login-icon">✈</div>

        <h2 class="login-title">Login to your account</h2>
        <div class="login-line"></div>

        <form action="/login" method="POST" class="login-form">
            <label>
                Email:
                <input type="email" name="email" placeholder="Enter your email" required>
            </label>

            <label>
                Password:
                <div class="password-wrapper">
                    <input type="password" name="password" id="password-input" placeholder="Enter your password" required
                        {% if error %}aria-invalid="true"{% endif %}>

                    <button type="button" class="toggle-password-btn" id="toggle-password" aria-label="Show password">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                {% if error %}
                <small class="error-msg" role="alert">
                    Invalid email or password
                </small>
                {% endif %}
            </label>

            <button type="submit" class="login-confirm-btn">Confirm</button>

            <div class="register-link">
                <a href="/register" class="secondary"><small>Create a new account</small></a>
            </div>

        </form>
    </article>
</div>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const togglePassword = document.getElementById("toggle-password");
        const passwordInput = document.getElementById("password-input");

        togglePassword.addEventListener("click", function() {
            {# Check current type and toggle it #}
            const currentType = passwordInput.getAttribute("type");
            const newType = currentType === "password" ? "text" : "password";

            passwordInput.setAttribute("type", newType);

            {# Changing the icon colour #}
            if (newType === "text") {
                this.style.color = "black";
            } else {
                this.style.color = "black";
            }
        });
    });
</script>
{% endblock %}
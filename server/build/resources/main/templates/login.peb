{% extends "base.peb" %}
{% block title %}Login{% endblock %}

{# Used gemini for specific style adjustments (lines 6,8,23,25,30) #}
{% block content %}
<div style="max-width: 500px; margin: 0 auto; padding-top: 2rem;">

    <h2 style="text-align: center; margin-bottom: 2rem;">Login to your account</h2>

    <article>
        <form action="/login" method="POST">

            <label>
                Email:
                <input type="email" name="email" required>
            </label>

            <label>
                Password:
                <input type="password" name="password" required>
            </label>

            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 2rem;">
                <a href="/register" class="secondary"><small>Create a new account</small></a>
                <button type="submit" style="width: auto; margin: 0; padding: 0.5rem 2rem;">Confirm</button>
            </div>

        </form>
    </article>
</div>
{% endblock %}
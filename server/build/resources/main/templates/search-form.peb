{# @pebvariable name="airports" type="List<Airport>" #}
{% extends "base.peb" %}

{% block styles %}
{# Used gemini to get help with the precise css (lines 6-32) #}
<style>
    .passenger-dropdown ul {
        width: 280px;
        padding: 0.5rem;
    }

    .passenger-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem;
    }

    .passenger-row span {
        font-weight: bold;
        color: var(--pico-color);
    }

    .passenger-row input[type="number"] {
        width: 80px;
        margin-bottom: 0;
        padding: 0.25rem 0.5rem;
        text-align: center;
    }

    .passenger-dropdown li {
        list-style: none;
    }
</style>
{% endblock %}

{% block content %}
<form action="/search" method="GET">
    <datalist id="airport-list">
        {% for airport in airports %}
            <option value="{{ airport.name }}">{{ airport.city }}, {{ airport.country }}</option>
        {% endfor %}
    </datalist>

    <div class="grid">
        <label>
            <input type="radio" name="trip_type" id="trip-one-way" value="one-way" checked>
            One-way
        </label>
        <label>
            <input type="radio" name="trip_type" id="trip-return" value="return">
            Return
        </label>
    </div>

    <div class="grid">
        <label>
            From:
            <input type="text" name="origin" placeholder="Search City or Airport" list="airport-list" autocomplete="off" required>
        </label>
        <label>
            To:
            <input type="text" name="destination" placeholder="Search City or Airport" list="airport-list" autocomplete="off" required>
        </label>
    </div>

    <div class="grid">
        <label>
            Depart:
            <input type="date" name="depart_date" required>
        </label>
        <label>
            Return:
            <input type="date" name="return_date" id="return-date" disabled>
        </label>
    </div>
    <div class="grid">
        <label>
            Cabin class
            <select name="cabin_class" required>
                <option value="economy" selected>Economy</option>
                <option value="business">Business Class</option>
                <option value="first">First Class</option>
            </select>
        </label>

        <label>
            Passengers
            <details class="dropdown passenger-dropdown">
                <summary role="button" id="passenger-summary" class="secondary outline">1 Adult</summary>
                <ul>
                    <li>
                        <div class="passenger-row">
                            <span>Adults (18+)</span>
                            <input type="number" name="adults" id="num-adults" value="1" min="1" max="50">
                        </div>
                    </li>
                    <li>
                        <div class="passenger-row">
                            <span>Children (0-17)</span>
                            <input type="number" name="children" id="num-children" value="0" min="0" max="50">
                        </div>
                    </li>
                </ul>
            </details>
        </label>
    </div>

    <div style="text-align: center; margin-top: 2rem;">
        <button type="submit">Search</button>
    </div>

</form>
{% endblock %}

{% block scripts %}

{# Used gemini to understand javascript functionality used to change element properties #}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        {# Toggling the return date input #}
        const oneWayRadio = document.getElementById("trip-one-way");
        const returnRadio = document.getElementById("trip-return");
        const returnDateInput = document.getElementById("return-date");

        function toggleReturnDate() {
            {# If return is selected then enable the return date input #}
            if (returnRadio.checked) {
                returnDateInput.disabled = false;
                returnDateInput.required = true;
            } else {
                returnDateInput.disabled = true;
                returnDateInput.required = false;
                returnDateInput.value = "";
            }
        }

        oneWayRadio.addEventListener("change", toggleReturnDate);
        returnRadio.addEventListener("change", toggleReturnDate);

        {# Updating passenger count #}
        const passengerSummary = document.getElementById("passenger-summary")
        const adults = document.getElementById("num-adults");
        const children = document.getElementById("num-children");

        function updatePassengerSummary() {
            const numAdults = parseInt(adults.value) || 1;
            const numChildren = parseInt(children.value) || 0;
            const total = numAdults + numChildren;

            if (total === 1) {
                passengerSummary.textContent = "1 Adult";
            } else {
                passengerSummary.textContent = total + " Passengers";
            }
        }

        {# Enforcing min max limits for passenger count #}
        function enforceMinMax(event) {
            const input = event.target;
            const min = parseInt(input.min, 10);
            const max = parseInt(input.max, 10);
            let value = parseInt(input.value, 10);

            if (isNaN(value) || value < min) {
                input.value = min;
            }
            else if (value > max) {
                input.value = max;
            }

            updatePassengerSummary();
        }

        {# Blocking invalid inputs #}
        function blockInvalidKeys(event) {
            if (['-', '+', 'e', 'E', '.'].includes(event.key)) {
                event.preventDefault();
            }
        }

        adults.addEventListener('input', updatePassengerSummary);
        children.addEventListener('input', updatePassengerSummary);

        adults.addEventListener('change', enforceMinMax);
        children.addEventListener('change', enforceMinMax);

        adults.addEventListener('keydown', blockInvalidKeys);
        children.addEventListener('keydown', blockInvalidKeys);

        {# Run once to make sure the text is correct on page load #}
        updatePassengerSummary();
    });

    {# Making sure that the user enters/selects a valid airport name to sent to the backend #}
    document.addEventListener("DOMContentLoaded", function() {
        const originInput = document.querySelector('input[name="origin"]');
        const destinationInput = document.querySelector('input[name="destination"]');
        const datalist = document.getElementById('airport-list');

        const validAirports = Array.from(datalist.options).map(option => option.value);

        function requireDatalistMatch(inputElement) {
            inputElement.addEventListener('input', function() {
                if (validAirports.includes(inputElement.value) || inputElement.value === "") {
                    inputElement.setCustomValidity('');
                } else {
                    inputElement.setCustomValidity('Please select a valid airport from the list.');
                }
            });
        }

        requireDatalistMatch(originInput);
        requireDatalistMatch(destinationInput);
    });

    {# Prevents the user from entering a date from the past #}
    document.addEventListener("DOMContentLoaded", function() {
        const departDateInput = document.querySelector('input[name="depart_date"]');
        const returnDateInput = document.getElementById('return-date');

        const today = new Date().toLocaleDateString('en-CA'); // 'en-CA' forces the format to YYYY-MM-DD

        departDateInput.min = today;
        returnDateInput.min = today;

        {# Prevents the user from entering a return date before the departure date #}
        departDateInput.addEventListener('change', function() {
            returnDateInput.min = this.value;

            if (returnDateInput.value && returnDateInput.value < this.value) {
                returnDateInput.value = this.value;
            }
        });
    });

</script>
{% endblock %}

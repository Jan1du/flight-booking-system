{# Base template #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Book your flight{% endblock %}</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">

    <style>
        body {
            background-color: #f8f9fb;
        }

        header {
            border-bottom: 1px solid #d9d9d9;
            margin-bottom: 2rem;
            padding: 1rem 0;
            background-color: white;
        }

        nav a {
            border-radius: 999px;
            padding: 0.4rem 0.8rem;
            text-decoration: none;
        }

        .active-link {
            background-color: #e8f1ff;
            font-weight: bold;
        }

        .page-title {
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            color: #666;
            margin-bottom: 1.5rem;
        }

        .card-box {
            background: white;
            border: 1px solid #ddd;
            border-radius: 16px;
            padding: 1.5rem;
        }

        footer {
            text-align: center;
            color: #666;
            margin-top: 3rem;
            padding: 2rem 0;
        }

        {% block styles %}
        {% endblock %}
    </style>
</head>
<body>

<header>
    <nav class="container">
        <ul>
            <li><strong>SkyBooker</strong></li>
        </ul>

        <ul>
            <li><a href="/" class="{{ active_nav == 'book' ? 'active-link' : 'secondary' }}">Book</a></li>
            <li><a href="/manage" class="{{ active_nav == 'manage' ? 'active-link' : 'secondary' }}">Manage</a></li>
            <li><a href="/about" class="{{ active_nav == 'about' ? 'active-link' : 'secondary' }}">About us</a></li>
            <li><a href="/login" class="{{ active_nav == 'login' ? 'active-link' : 'secondary' }}">Login</a></li>
            <li><a href="/register" class="{{ active_nav == 'register' ? 'active-link' : 'secondary' }}">Register</a></li>
        </ul>
    </nav>
</header>

<main class="container">
    {% block content %}
    {% endblock %}
</main>

<footer>
    SkyBooker flight booking website
</footer>

<script>
    {% block scripts %}
    {% endblock %}
</script>

</body>
</html>


